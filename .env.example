# Copia este archivo como .env (git lo ignora) SOLO si quieres usar el modo online gratuito.
# No pongas llaves en el repositorio. Todo es opcional: sin esto la app funciona completa en offline.

# Modo de red: offline (por defecto) | online
IAF_MODO_RED=offline

# Proveedor del puente (ver bridge_providers.yaml) y su modelo de la capa gratuita
IAF_BRIDGE_PROVIDER=gemini
IAF_BRIDGE_MODEL=gemini-2.5-flash

# Llave de la capa gratuita (Google AI Studio). Sin tarjeta ni facturación enlazada.
GEMINI_API_KEY=
